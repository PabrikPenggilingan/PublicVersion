# Environment
NODE_ENV=development

# Server
PORT=3000

# Docker Compose Database Configuration (Used to create DB in Docker)
DB_USER=gabah_user
DB_PASSWORD=gabah_password
DB_NAME=gabah_db

# Database - Local Development (Pure Local - Default)
DATABASE_URL=postgresql://gabah_user:gabah_password@localhost:5432/gabah_db
LOG_DATABASE_URL=postgresql://gabah_user:gabah_password@localhost:5432/gabah_logs

# Database - Docker (uncomment jika pakai Docker Compose)
# DATABASE_URL=postgresql://gabah_user:gabah_password@db:5432/gabah_db
# LOG_DATABASE_URL=postgresql://gabah_user:gabah_password@db:5432/gabah_logs

# JWT
JWT_SECRET=local-dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Supabase Storage (Optional for local development, will mock if empty)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=gabah-files

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# NGINX (only for Docker Compose)
NGINX_PORT=80

# ─── Super Admin Monitoring ─────────────────────────────────────────────────────
# Required only if you want to use the /admin/monitoring dashboard.
#
# GCP Cloud Run Metrics
# - GCP_PROJECT_ID: Your GCP project ID (e.g. my-project-123456)
# - GCP_CLOUD_RUN_SERVICE: Name of your Cloud Run service (default: gabah-api)
# - GCP_REGION: Cloud Run region (default: asia-southeast1)
# - GCP_SERVICE_ACCOUNT_KEY: Only needed for LOCAL DEV.
#     Set to the full JSON content of your service account key (single line).
#     In Cloud Run production, leave EMPTY — Workload Identity handles auth.
GCP_PROJECT_ID=
GCP_CLOUD_RUN_SERVICE=gabah-api
GCP_CLOUD_RUN_SERVICE_STAGING=gabah-api-staging
GCP_REGION=asia-southeast1
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Supabase Admin (service_role key — for storage monitoring)
# WARNING: service_role key bypasses Row Level Security. Never expose to frontend.
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=gabah-files
