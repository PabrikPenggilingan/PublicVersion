# ============================================================
# Template Konfigurasi — Salin file ini menjadi .env
# Jalankan: copy .env.example .env  (Windows)
#           cp .env.example .env    (Mac/Linux)
# ============================================================

# Database
DB_USER=postgres
DB_PASSWORD=12345678
DB_NAME=gabah_db

# JWT — WAJIB diganti dengan string acak yang panjang di lingkungan nyata
JWT_SECRET=ganti-dengan-secret-key-yang-kuat-dan-panjang
JWT_EXPIRES_IN=7d

# Cloudflare R2 Storage (opsional — kosongkan jika belum digunakan)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
